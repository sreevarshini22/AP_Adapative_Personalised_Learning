{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/",
      "destination": "/frontend/login.html"
    },
    {
      "source": "/login",
      "destination": "/frontend/login.html"
    },
    {
      "source": "/student-login",
      "destination": "/frontend/student-login.html"
    },
    {
      "source": "/teacher-login",
      "destination": "/frontend/teacher-login.html"
    },
    {
      "source": "/student-dashboard",
      "destination": "/frontend/student-dashboard.html"
    },
    {
      "source": "/teacher-dashboard",
      "destination": "/frontend/teacher-dashboard.html"
    },
    {
      "source": "/student-details",
      "destination": "/frontend/student-details.html"
    },
    {
      "source": "/ml-performance",
      "destination": "/frontend/ml-performance.html"
    },
    {
      "source": "/styles.css",
      "destination": "/frontend/styles.css"
    },
    {
      "source": "/:path((?!frontend/).*)",
      "destination": "/frontend/:path"
    }
  ]
}
